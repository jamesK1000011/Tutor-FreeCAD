{
 "$comment": "A Tutor lesson (agentlink/tutor/lessons.py): one <id>.lesson.json in a lessons/ folder. Data only: no code, no expressions. Checked with datafiles.validate (a subset of JSON Schema); lessons.py adds what this subset cannot say (one setup kind, $var references, step ids, the check and target vocabularies).",
 "type": "object",
 "required": [
  "schema",
  "id",
  "version",
  "title",
  "steps"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "type": "integer",
   "enum": [
    1
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9][a-z0-9-]*)+$",
   "maxLength": 80
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "title": {
   "type": "string",
   "minLength": 3,
   "maxLength": 80
  },
  "summary": {
   "type": "string",
   "maxLength": 300
  },
  "level": {
   "type": "string",
   "enum": [
    "first-steps",
    "basic",
    "intermediate"
   ]
  },
  "minutes": {
   "type": "integer",
   "minimum": 1,
   "maximum": 120
  },
  "tags": {
   "type": "array",
   "maxItems": 12,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9-]+$"
   }
  },
  "requires": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "freecad": {
     "type": "string"
    },
    "agentlink_api": {
     "type": "string"
    },
    "workbenches": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
     }
    }
   }
  },
  "setup": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "doc": {
     "type": "string",
     "enum": [
      "new"
     ]
    },
    "fixture": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+\\.FCStd$"
    },
    "calls": {
     "type": "array",
     "minItems": 1,
     "maxItems": 20,
     "items": {
      "$ref": "#/definitions/call"
     }
    },
    "bind": {
     "type": "object"
    },
    "after": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9][a-z0-9-]*)+$",
     "description": "The lesson this one comes after (the chapter before): its end state is the start of this one. When the document in front already passes that lesson's result, the lesson goes on in it; else a new document is made and the chapters before are done through the tools."
    }
   }
  },
  "vars": {
   "type": "object"
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "items": {
    "$ref": "#/definitions/step"
   }
  },
  "view": {
   "type": "string",
   "enum": [
    "isometric",
    "front",
    "top",
    "right",
    "left",
    "rear",
    "bottom",
    "keep"
   ],
   "description": "How the lesson's 3D view is set after setup (fitted to the part), and for its steps that light faces or edges; keep leaves the person's camera. Default isometric."
  },
  "result": {
   "type": "object",
   "description": "The lesson's end state as a check (queries, not bindings): a later chapter's setup.after goes on in a document that passes it."
  },
  "course": {
   "type": "object",
   "required": [
    "id",
    "chapter"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$",
     "maxLength": 40
    },
    "title": {
     "type": "string",
     "maxLength": 80
    },
    "chapter": {
     "type": "integer",
     "minimum": 1,
     "maximum": 99
    }
   },
   "description": "A chapter of a course: the course's id and title, and this chapter's number."
  }
 },
 "definitions": {
  "call": {
   "type": "object",
   "required": [
    "tool"
   ],
   "additionalProperties": false,
   "properties": {
    "tool": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    },
    "args": {
     "type": "object"
    }
   }
  },
  "step": {
   "type": "object",
   "required": [
    "id",
    "say"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$",
     "maxLength": 40
    },
    "say": {
     "type": "string",
     "minLength": 1,
     "maxLength": 240,
     "description": "The instruction, in Simplified Technical English (ste.py): each sentence one instruction, starting with an action verb, at most 20 words; UI names in **bold**."
    },
    "explain": {
     "type": "string",
     "maxLength": 1200,
     "description": "A longer note for the agent (status detail); never in the callout."
    },
    "targets": {
     "type": "array",
     "maxItems": 6,
     "items": {
      "type": "object"
     }
    },
    "do": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "$ref": "#/definitions/call"
     }
    },
    "check": {
     "type": "object"
    },
    "bind": {
     "type": "object"
    },
    "hints": {
     "type": "array",
     "maxItems": 3,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
     },
     "description": "The hint ladder: 1 a nudge (where to look), 2 the field only, 3 the value. Rungs 1 and 2 never say the value the step's check wants (lessons.hint_problems)."
    },
    "branches": {
     "type": "array",
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": [
       "when",
       "goto"
      ],
      "additionalProperties": false,
      "properties": {
       "when": {
        "type": "object"
       },
       "goto": {
        "type": "string"
       },
       "say": {
        "type": "string",
        "maxLength": 240
       }
      }
     }
    },
    "next": {
     "type": "string"
    },
    "view": {
     "type": "string",
     "enum": [
      "isometric",
      "front",
      "top",
      "right",
      "left",
      "rear",
      "bottom",
      "keep"
     ],
     "description": "This step's view when it comes up (fitted); left out, a step lighting faces or edges takes the lesson's view."
    },
    "why": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120,
     "description": "The explainer: one short sentence, at most 15 words, shown under the instruction when explanations are on."
    }
   }
  }
 }
}
