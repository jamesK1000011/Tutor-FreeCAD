{
 "$comment": "A Tutor lesson (agentlink/tutor/lessons.py): one <id>.lesson.json in a lessons/ folder. Data only: no code, no expressions. Checked with datafiles.validate (a subset of JSON Schema); lessons.py adds what this subset cannot say (one setup kind, $var references, step ids, the check and target vocabularies).",
 "type": "object",
 "required": ["schema", "id", "version", "title", "steps"],
 "additionalProperties": false,
 "properties": {
  "schema": {"type": "integer", "enum": [1]},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 80},
  "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "title": {"type": "string", "minLength": 3, "maxLength": 80},
  "summary": {"type": "string", "maxLength": 300},
  "level": {"type": "string", "enum": ["first-steps", "basic", "intermediate"]},
  "minutes": {"type": "integer", "minimum": 1, "maximum": 120},
  "tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
  "requires": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "freecad": {"type": "string"},
    "agentlink_api": {"type": "string"},
    "workbenches": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}}
   }
  },
  "setup": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "doc": {"type": "string", "enum": ["new"]},
    "fixture": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.FCStd$"},
    "calls": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/definitions/call"}},
    "bind": {"type": "object"}
   }
  },
  "vars": {"type": "object"},
  "steps": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/definitions/step"}}
 },
 "definitions": {
  "call": {
   "type": "object",
   "required": ["tool"],
   "additionalProperties": false,
   "properties": {
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "args": {"type": "object"}
   }
  },
  "step": {
   "type": "object",
   "required": ["id", "say"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 40},
    "say": {"type": "string", "minLength": 1, "maxLength": 240},
    "explain": {"type": "string", "maxLength": 1200},
    "targets": {"type": "array", "maxItems": 6, "items": {"type": "object"}},
    "do": {"type": "array", "maxItems": 10, "items": {"$ref": "#/definitions/call"}},
    "check": {"type": "object"},
    "bind": {"type": "object"},
    "hints": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "branches": {
     "type": "array",
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": ["when", "goto"],
      "additionalProperties": false,
      "properties": {
       "when": {"type": "object"},
       "goto": {"type": "string"},
       "say": {"type": "string", "maxLength": 240}
      }
     }
    },
    "next": {"type": "string"}
   }
  }
 }
}
