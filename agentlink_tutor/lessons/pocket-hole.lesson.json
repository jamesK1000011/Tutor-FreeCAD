{
 "schema": 1,
 "id": "agentlink_tutor.pd.pocket-hole",
 "version": "1.0.0",
 "title": "Cut a pocket and drill a hole",
 "summary": "Sketch on a face, cut a pocket into the block, then drill a through hole.",
 "level": "first-steps",
 "minutes": 8,
 "tags": ["partdesign", "pocket", "hole", "sketch"],
 "requires": {"freecad": ">=1.0", "agentlink_api": ">=1,<2", "workbenches": ["PartDesignWorkbench"]},
 "setup": {
  "calls": [
   {"tool": "doc_new", "args": {"name": "PocketLesson"}},
   {"tool": "pd_body_new", "args": {}},
   {"tool": "sketch_new", "args": {"plane": "XY"}},
   {"tool": "sketch_add", "args": {"items": [{"kind": "rectangle", "center": [0, 0], "size": [40, 40], "dims": true}]}},
   {"tool": "pd_pad", "args": {"length": 10}}
  ],
  "bind": {"body": {"exists": "PartDesign::Body"}}
 },
 "vars": {"depth": 4, "hole": 6},
 "steps": [
  {"id": "top", "say": "Select the top face of the block, then press **Create sketch**.",
   "explain": "A sketch on a face sits on the part itself, so what you draw lines up with it.",
   "targets": [{"face": {"normal": [0, 0, 1], "largest": true}, "of": "$body"}, {"cmd": "PartDesign_NewSketch"}],
   "check": {"new": "Sketcher::SketchObject"},
   "bind": {"top": {"new": "Sketcher::SketchObject"}},
   "hints": ["Click the flat face on top, then the red-white sketch button.", "Both are ringed."],
   "do": [{"tool": "sketch_new", "args": {"face": {"at": [0, 0, 10], "normal": [0, 0, 1]}}}]},
  {"id": "rect", "say": "Draw a rectangle 20 mm wide and 10 mm high in the middle, then press **Close**.",
   "targets": [{"cmd": "Sketcher_CreateRectangle"}],
   "check": {"all": [{"sketch": "$top", "closed": true}, {"editing": null}]},
   "hints": ["The rectangle tool is in the Sketcher toolbar.", "Click two opposite corners, then set the sizes."],
   "do": [{"tool": "sketch_add", "args": {"sketch": "$top", "items": [{"kind": "rectangle", "center": [0, 0], "size": [20, 10], "dims": true}]}}]},
  {"id": "pocket", "say": "With the sketch selected, press **Pocket**.",
   "explain": "Pocket is Pad's opposite: it cuts the sketch's shape into the part.",
   "targets": [{"cmd": "PartDesign_Pocket"}],
   "check": {"new": "PartDesign::Pocket"},
   "bind": {"pocket": {"new": "PartDesign::Pocket"}},
   "do": [{"tool": "pd_pocket", "args": {"sketch": "$top", "length": 5}}],
   "branches": [{"when": {"new": "PartDesign::Pad"}, "goto": "undo-pad", "say": "That was Pad, which adds. Let's undo it."}]},
  {"id": "depth", "say": "Set the pocket's **Length** to 4 mm, then press **OK**.",
   "targets": [{"task": {"name": "lengthEdit", "label": "Length"}}, {"task": {"button": "ok"}}],
   "check": {"all": [{"prop": "$pocket", "name": "Length", "eq": "$depth", "tol": 0.01, "unit": "mm"}, {"task_open": null}, {"valid": "$pocket"}]},
   "hints": ["The Length box is in the Tasks panel.", "Type 4 and press OK.", "Length = 4 mm."],
   "do": [{"tool": "feature_edit", "args": {"feature": "$pocket", "set": {"Length": "$depth"}}}]},
  {"id": "corner", "say": "Make a new sketch on the top face again, for the hole.",
   "targets": [{"face": {"normal": [0, 0, 1], "largest": true}, "of": "$body"}, {"cmd": "PartDesign_NewSketch"}],
   "check": {"new": "Sketcher::SketchObject"},
   "bind": {"spot": {"new": "Sketcher::SketchObject"}},
   "do": [{"tool": "sketch_new", "args": {"face": {"at": [15, 15, 10], "normal": [0, 0, 1]}}}]},
  {"id": "circle", "say": "Draw a circle near one corner, at x 15 and y 15, then press **Close**.",
   "explain": "A hole is drilled at the centre of each circle; its size comes from the Hole dialog.",
   "targets": [{"cmd": "Sketcher_CreateCircle"}],
   "check": {"all": [{"sketch": "$spot", "closed": true}, {"editing": null}]},
   "do": [{"tool": "sketch_add", "args": {"sketch": "$spot", "items": [{"kind": "circle", "center": [15, 15], "diameter": 6}]}}]},
  {"id": "hole", "say": "Press **Hole**, set **Diameter** to 6 mm and **Depth** to Through all, then **OK**.",
   "targets": [{"cmd": "PartDesign_Hole"}],
   "check": {"all": [{"new": "PartDesign::Hole"}, {"task_open": null}]},
   "bind": {"drill": {"new": "PartDesign::Hole"}},
   "hints": ["Hole is in the Part Design toolbar, next to Pocket.", "Diameter and Depth are in the Tasks panel.", "Diameter = 6 mm, Depth type = Through all."],
   "do": [{"tool": "pd_hole", "args": {"sketch": "$spot", "diameter": 6, "depth": "through"}}]},
  {"id": "see", "say": "Done: a 4 mm pocket and a 6 mm hole right through.",
   "targets": [{"tree": "$drill"}],
   "check": {"all": [{"prop": "$drill", "name": "Diameter", "eq": "$hole", "tol": 0.01, "unit": "mm"}, {"valid": "$drill"}, {"volume": "$body", "eq": 14917.26, "tol": 0.5}]}},
  {"id": "undo-pad", "say": "Press **Undo** (⌘Z).",
   "targets": [{"cmd": "Std_Undo"}],
   "check": {"volume": "$body", "eq": 16000, "tol": 1},
   "do": [{"tool": "history_undo", "args": {}}],
   "next": "pocket"}
 ]
}
