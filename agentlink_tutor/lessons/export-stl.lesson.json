{
 "schema": 1,
 "id": "agentlink_tutor.io.export-stl",
 "version": "1.0.0",
 "title": "Export a part as STL for printing",
 "summary": "Check the part is one sound solid, select it, and export it as an STL mesh a slicer reads.",
 "level": "first-steps",
 "minutes": 3,
 "tags": [
  "export",
  "stl",
  "3d-printing"
 ],
 "requires": {
  "freecad": ">=1.0",
  "agentlink_api": ">=1,<2"
 },
 "setup": {
  "calls": [
   {
    "tool": "doc_new",
    "args": {
     "name": "ExportLesson"
    }
   },
   {
    "tool": "pd_body_new",
    "args": {}
   },
   {
    "tool": "sketch_new",
    "args": {
     "plane": "XY"
    }
   },
   {
    "tool": "sketch_add",
    "args": {
     "items": [
      {
       "kind": "rectangle",
       "center": [
        0,
        0
       ],
       "size": [
        30,
        30
       ],
       "dims": true
      }
     ]
    }
   },
   {
    "tool": "pd_pad",
    "args": {
     "length": 5
    }
   }
  ],
  "bind": {
   "body": {
    "exists": "PartDesign::Body"
   }
  }
 },
 "steps": [
  {
   "id": "sound",
   "say": "Make sure that the part is one closed solid.",
   "why": "A gap or two pieces in the solid can make the print fail.",
   "targets": [
    {
     "tree": "$body"
    }
   ],
   "check": {
    "valid": "$body",
    "solid": true
   },
   "do": [
    {
     "tool": "body_check",
     "args": {
      "body": "$body"
     }
    }
   ]
  },
  {
   "id": "pick",
   "say": "Click **Body** in the tree.",
   "targets": [
    {
     "tree": "$body"
    }
   ],
   "check": {
    "selected": "$body"
   },
   "hints": [
    "Look in the Model tab, on the left.",
    "The ring shows its row."
   ],
   "do": [
    {
     "tool": "selection",
     "args": {
      "objects": [
       "$body"
      ]
     }
    }
   ]
  },
  {
   "id": "export",
   "say": "Select **File › Export**. Set the type to **STL Mesh**. Save the file as Part.stl.",
   "why": "STL is the mesh format that all slicers read.",
   "targets": [
    {
     "menu": "Std_Export"
    },
    {
     "cmd": "Std_Export"
    }
   ],
   "check": {
    "any": [
     {
      "file": "Part.stl",
      "min_bytes": 284
     },
     {
      "used": "Std_Export"
     }
    ]
   },
   "hints": [
    "Export is in the File menu, under Save.",
    "In the dialog, set the file type to STL Mesh.",
    "Name: Part.stl, type: STL Mesh (*.stl)."
   ],
   "do": [
    {
     "tool": "export",
     "args": {
      "objects": [
       "$body"
      ],
      "format": "stl",
      "path": "Part.stl"
     }
    }
   ]
  }
 ]
}
